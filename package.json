{
  "name": "paws-down",
  "private": true,
  "version": "0.1.0",
  "description": "No-flake dates: both put $5 down, show up and get it back. AI wingcats arrange the date.",
  "license": "MIT",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20.3" },
  "scripts": {
    "practice:server": "PAWS_DOWN_PRACTICE=1 PAWS_DOWN_DB=:memory: npm -w @paws-down/server start",
    "server": "npm -w @paws-down/server start",
    "sandbox:server": "PAWS_DOWN_DB=:memory: npm -w @paws-down/server start",
    "wingcats": "npm -w @paws-down/agents start",
    "web": "npm -w @paws-down/web run dev",
    "test": "npm -w @paws-down/server test && npm -w @paws-down/agents test",
    "paypal:check": "npm -w @paws-down/server run -s paypal:check --",
    "spec:validate": "apimatic api validate --file=apimatic/src/spec/openapi.yaml",
    "sdk:generate": "apimatic sdk generate -l typescript --codegen-version v4 -i apimatic -f && npm --prefix apimatic/sdk/typescript install --no-audit --no-fund && npm --prefix apimatic/sdk/typescript run build",
    "plugin:generate": "apimatic plugin generate -i apimatic -d plugin -f"
  },
  "devDependencies": { "@apimatic/cli": "^1.5.0" }
}
